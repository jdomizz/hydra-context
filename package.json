{
  "name": "hydra-context",
  "version": "0.2.0",
  "description": "Isolated eval scopes for hydra-synth instances",
  "keywords": [
    "creative-coding",
    "eval",
    "glsl",
    "hydra-synth",
    "livecoding",
    "scope",
    "synth"
  ],
  "homepage": "https://github.com/jdomizz/hydra-context#readme",
  "bugs": {
    "url": "https://github.com/jdomizz/hydra-context/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "jdomizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdomizz/hydra-context.git"
  },
  "sponsor": {
    "url": "https://opencollective.com/hydra-synth"
  },
  "qna": "https://github.com/jdomizz/hydra-context/discussions",
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host",
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.types.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm check",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm clean && pnpm build && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "hydra-synth": "^1.4.0",
    "oxc-standard": "^1.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.85.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.4.2"
}
