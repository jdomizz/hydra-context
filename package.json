{
  "name": "hydra-context",
  "version": "0.0.0",
  "description": "Isolated eval scopes for hydra-synth instances",
  "keywords": [
    "creative-coding",
    "eval",
    "glsl",
    "hydra-synth",
    "livecoding",
    "scope",
    "synth"
  ],
  "homepage": "https://github.com/jdomizz/hydra-context#readme",
  "bugs": {
    "url": "https://github.com/jdomizz/hydra-context/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "jdomizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdomizz/hydra-context.git"
  },
  "sponsor": {
    "url": "https://opencollective.com/hydra-synth"
  },
  "qna": "https://github.com/jdomizz/hydra-context/discussions",
  "files": [
    "src",
    "!src/**/*.spec.js",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm check",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "hydra-synth": "^1.4.0",
    "oxc-standard": "^1.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.85.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.4.2"
}
